// The Watch app's settings, included from Base.xcconfig.
//
// The project's configurations apply to every target, so the Watch's settings are keyed: the
// SDK and platforms on the target's name, as Base.xcconfig reads them (Xcode's wizard named it "PlusPlusWatch Watch App", which
// :c99extidentifier turns into a usable key), and the rest on the watch SDKs, which only that
// target builds with.

SDKROOT_PlusPlusWatch_Watch_App = watchos
SUPPORTED_PLATFORMS_PlusPlusWatch_Watch_App = watchos watchsimulator

WATCHOS_DEPLOYMENT_TARGET = 27.0
TARGETED_DEVICE_FAMILY[sdk=watch*] = 4
ONLY_ACTIVE_ARCH[sdk=watchsimulator*] = YES
// Embedded in the phone app, so it is copied in, never installed on its own.
SKIP_INSTALL[sdk=watch*] = YES

PRODUCT_BUNDLE_IDENTIFIER[sdk=watch*] = com.plusplusinc.plusplus.watchkitapp
// The same one key as the phone's, HealthKit: a workout session needs it.
CODE_SIGN_ENTITLEMENTS[sdk=watch*] = Config/PlusPlus.entitlements

// The background mode that keeps the app running through a workout has no INFOPLIST_KEY_
// setting, so it is in its own file; the rest is generated.
INFOPLIST_FILE[sdk=watch*] = Config/Watch-Info.plist
INFOPLIST_KEY_WKApplication[sdk=watch*] = YES
INFOPLIST_KEY_WKCompanionAppBundleIdentifier[sdk=watch*] = com.plusplusinc.plusplus
