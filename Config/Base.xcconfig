// Settings shared by every configuration.
//
// Everything lives here rather than in project.pbxproj so that build configuration is a
// reviewable text diff. If you find yourself changing a setting in Xcode's Build Settings tab,
// move it here instead — the pbxproj is meant to stay near-static.

// MARK: - Identity
//
// project.pbxproj carries no target-level build settings at all, so settings Xcode's templates
// normally put there (PRODUCT_NAME, CODE_SIGN_STYLE) have to be stated here.

PRODUCT_NAME = $(TARGET_NAME)
PRODUCT_BUNDLE_IDENTIFIER = com.plusplusinc.plusplus
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// MARK: - Platform

IPHONEOS_DEPLOYMENT_TARGET = 26.0
SDKROOT = iphoneos
TARGETED_DEVICE_FAMILY = 1,2
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
// Simulator builds compile only the running Mac's slice; device archives are arm64-only anyway.
ONLY_ACTIVE_ARCH[sdk=iphonesimulator*] = YES

// MARK: - Swift
//
// SWIFT_VERSION 6.0 selects the Swift 6 *language mode*, which makes data-race safety a compile
// error rather than a warning. Turning this on later, once there is real concurrent code, is
// dramatically more painful than starting with it.

SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_UPCOMING_FEATURE_EXISTENTIAL_ANY = YES
SWIFT_EMIT_LOC_STRINGS = YES

// Xcode 26's defaults for new projects, made explicit. Together they mean app code is
// single-threaded until it says otherwise: everything is on the main actor, async functions
// stay on the caller's actor, and leaving the main actor is a deliberate `@concurrent` or
// `nonisolated`. UI code stops paying Sendable ceremony for work that was never concurrent.
// The domain and storage packages opt out of the MainActor default in their Package.swift.
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor

// MARK: - Signing
//
// DEVELOPMENT_TEAM is intentionally absent. Set it in Config/Local.xcconfig (gitignored) so the
// team ID never lands in the repo; Xcode Cloud manages signing itself.

CODE_SIGN_STYLE = Automatic

// MARK: - Info.plist
//
// Generated from these settings; there is no Info.plist file to drift out of sync.

GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = PlusPlus
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait
// Declared here so App Store Connect stops asking on every upload. Revisit if the app ever
// ships its own cryptography beyond standard HTTPS.
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO

// MARK: - Hygiene

// App/ is a buildable folder, so anything dropped in it ships inside the app bundle, including
// a stray README or an agent's scratch notes. Keep prose out of the bundle.
EXCLUDED_SOURCE_FILE_NAMES = *.md *.txt *.log .gitkeep .DS_Store

ENABLE_USER_SCRIPT_SANDBOXING = YES
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = YES

// Optional developer-local overrides (team ID, custom bundle id). Gitignored; absent by default.
#include? "Local.xcconfig"
