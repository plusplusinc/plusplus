<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Only keys that GENERATE_INFOPLIST_FILE cannot synthesise belong here. Everything else
	     stays in Base.xcconfig as an INFOPLIST_KEY_* build setting. Xcode merges the two. -->

	<!-- Lets CloudKit push remote changes to the device. Without it SwiftData only notices
	     remote edits when it happens to fetch, so phone and Watch drift apart silently. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
